(mini_auth_site) {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@api path /api/* /health /logout /docs* /openapi.json /redoc* /.well-known/* /v1/jwks /jwks.json /oauth/* /oidc/*
	handle @api {
		# API, discovery and legacy HTML routes stay on FastAPI.
		reverse_proxy api:8000
	}

	handle {
		root * /srv/www/auth
		try_files {path} /index.html
		file_server
	}
}

:80 {
	import mini_auth_site
}

auth.liuyidi.me {
	import mini_auth_site
}

{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@mini-auth/auth-rn": ["../../packages/auth-rn/src/index.ts"],
      "@mini-auth/auth-ui": ["../../packages/auth-ui/src/index.ts"]
    }
  },
  "include": ["src"],
  "references": []
}

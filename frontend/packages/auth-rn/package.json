{
  "name": "@liuyidi/auth-rn",
  "version": "0.1.0",
  "description": "React Native auth SDK for mini-auth (client, PKCE, token helpers). No login UI.",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {},
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.3.3"
  }
}


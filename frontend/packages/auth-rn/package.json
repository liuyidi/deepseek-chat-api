{
  "name": "@mini-auth/auth-rn",
  "version": "0.1.0",
  "description": "Single React Native auth SDK for mini-auth, including auth client and login/register screens.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": "^0.81.0",
    "react-native-safe-area-context": "^5.0.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.3.3"
  }
}

